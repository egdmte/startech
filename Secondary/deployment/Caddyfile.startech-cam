# Merge this global block into the single global options block at the top of the
# VPS Caddyfile. Cloudflare ranges were checked against its published lists on
# 2026-08-25; re-check them before changing CDN/origin routing.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP
	}
}

dymtal.avartech.net {
	encode zstd gzip

	@cam path /*
	handle @cam {
		reverse_proxy 127.0.0.1:8765
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
	}

	# If this host must use the existing Cloudflare Origin certificate and that
	# certificate covers *.avartech.net, add the following after verification:
	# tls /etc/caddy/cf-origin.crt /etc/caddy/cf-origin.key
}
