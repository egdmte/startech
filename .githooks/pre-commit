#!/bin/sh
# =============================================================================
# pre-commit — kontrol.py'yi calistirir, dusen kontrol varsa commit'i durdurur.
#
# Kurulum (bir kere, her makinede):
#     git config core.hooksPath .githooks
#
# Kanca .git/hooks yerine burada duruyor cunku .git klonlanmaz. Boyle olunca
# kanca da depoyla birlikte gelir ve herkeste ayni calisir.
#
# Gercekten atlamak gerekiyorsa:  git commit --no-verify
# Ama once dusen kontrolu okuyun. §21, "sonra bakariz" ile baslamisti.
# =============================================================================

if ! command -v python3 >/dev/null 2>&1; then
    if command -v python >/dev/null 2>&1; then
        PY=python
    else
        echo "pre-commit: python bulunamadi, kontrol atlaniyor."
        exit 0
    fi
else
    PY=python3
fi

echo "pre-commit: kontrol.py calisiyor..."
"$PY" kontrol.py
KOD=$?

if [ $KOD -ne 0 ]; then
    echo ""
    echo "  Commit durduruldu."
    echo ""
    echo "  Belgede adi gecen bir sey kodda bulunamadi, ya da bir performans"
    echo "  sayisi tarihsiz yazildi. Ikisi de §21'in hikayesidir."
    echo ""
    echo "  Ya iddiayi duzeltin, ya sebebini kontrol-izin.txt'ye yazin."
    echo ""
    exit 1
fi

exit 0
