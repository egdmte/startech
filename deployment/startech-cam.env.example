# Copy to /etc/startech-cam.env with mode 0600 and root ownership.
# Never commit the populated file.
CAM_SESSION_SECRET=replace-with-at-least-32-random-characters
CAM_PASSWORD_HASH=replace-with-a-werkzeug-password-hash
CAM_DATABASE=/srv/startech-cam/shared/cam.sqlite3
CAM_TRUST_PROXY=1
CAM_COOKIE_SECURE=1
# Signed YAREN challenges expire quickly and every API request is rate-limited.
CAM_DEVICE_NONCE_LIFETIME_SECONDS=120
CAM_DEVICE_REQUEST_LIMIT=20
CAM_DEVICE_REQUEST_WINDOW_SECONDS=900
# A connected YAREN refreshes this idle lease on every authenticated poll.
CAM_DEVICE_LINK_IDLE_SECONDS=300
# Vehicle releases compare this published repository ref with the deployed commit.
KERIM_RELEASE_REMOTE=origin
KERIM_RELEASE_BRANCH=master
KERIM_RELEASE_LABEL=Published repository
